@@ -0,0 +1,33 @@
+#include "haptics_engine.h"
+#include "psvr2tk_capi_loader.h"
+#include "vr_motion_protocol.h"
+#include <chrono>
+#include <thread>
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+using namespace psvr2_toolkit::bridge;
+std::atomic<unsigned> nonzero{0};
+void Wait(){std::this_thread::sleep_for(std::chrono::milliseconds(2));}
+void Write(VRControllerType,const unsigned char* p){for(int i=0;i<32;++i)if(p[i]){++nonzero;break;}}
+void Check(bool b,const char* why){if(!b){std::cerr<<why<<'\n';std::exit(1);}}
+void Settle(){std::this_thread::sleep_for(std::chrono::milliseconds(40));}
+int main(){
+ vrmotion::BikeRoadLease lease;
+ Check(!lease.Update(0,0,1,true),"old publisher muted rhythm");
+ Check(lease.Update(1,1,100,true),"air mute missing");
+ Check(lease.Update(1,1,250,true),"lease expired early");
+ Check(!lease.Update(1,1,251,true),"stalled producer left mute latched");
+ Check(lease.Update(2,1,260,true),"new sample failed to renew");
+ Check(!lease.Update(3,0,270,true),"landing failed to release");
+ Check(!lease.Update(4,1,280,false),"invalid heartbeat retained mute");
+ Check(!lease.Update(4,2,280,true),"invalid payload muted");
+ p_psvr2_toolkit_wait_for_pcm=&Wait;p_psvr2_toolkit_write_pcm=&Write;
+ HapticsEngine h;h.SetRhythm(VRControllerType::Both,1,15);Check(h.Start(),"real PCM engine failed");Settle();
+ Check(nonzero>0,"grounded rhythm absent");h.SetVehicleRhythmMuted(true);Settle();nonzero=0;Settle();
+ Check(nonzero==0,"vehicle rhythm persisted in air");
+ h.Pulse(VRControllerType::Both,.8f,125,70);Settle();Check(nonzero>0,"mute swallowed contact pulse");
+ std::this_thread::sleep_for(std::chrono::milliseconds(180));nonzero=0;Settle();Check(nonzero==0,"road resumed before touchdown");
+ h.SetVehicleRhythmMuted(false);Settle();Check(nonzero>0,"touchdown failed to resume stored rhythm");h.Stop();
+ std::cout<<"Bike road lease + actual PCM rhythm mute / contact pulse / restore passed\n";
+}

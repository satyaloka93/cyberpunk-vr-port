 constexpr std::size_t kSlotProtocolMagic = 168;
 constexpr std::size_t kSlotProtocolVersion = 169;
 constexpr std::size_t kSlotProtocolHeartbeat = 170;
+// Optional v1 extension. Older publishers leave these zero; older readers
+// ignore them. A separate sequence prevents a running heartbeat renewing stale
+// mute state when gameplay/haptics stopped updating.
+constexpr std::size_t kSlotBikeRoadMute = 171;
+constexpr std::size_t kSlotBikeRoadSequence = 172;
+class BikeRoadLease {
+ public:
+  bool Update(float sequence, float mute, uint64_t nowMs, bool protocolReady) {
+    if(!protocolReady || !std::isfinite(sequence) || sequence<1 || sequence>1000000 ||
+       std::floor(sequence)!=sequence || (mute!=0 && mute!=1)) {*this={};return false;}
+    if(!m_valid || sequence!=m_sequence) {m_valid=true;m_sequence=sequence;m_since=nowMs;m_mute=mute==1;}
+    if(nowMs<m_since || nowMs-m_since>150){return false;}
+    return m_mute;
+  }
+ private:
+  float m_sequence{};uint64_t m_since{};bool m_valid{},m_mute{};
+};
 constexpr float kProtocolMagic = 18512.0f;
